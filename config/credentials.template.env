# =====================================================================
# LV Robotics — credentials template (SAFE TO COMMIT)
# ---------------------------------------------------------------------
# Copy this file to config/secrets.env and fill in real values.
# config/secrets.env is git-ignored and must NEVER be committed.
#   cp config/credentials.template.env config/secrets.env
# =====================================================================

# ── Supabase — CURRENT project ───────────────────────────────────────
SUPABASE_PROJECT_REF=
SUPABASE_URL=
# anon key: PUBLIC by design (used in client code; protected by RLS)
SUPABASE_ANON_KEY=
# service_role key: SECRET — full DB access. NOT used by the static site.
SUPABASE_SERVICE_ROLE_KEY=
LEGACY_AUTHOR_EMAIL=

# ── Meetup GraphQL API (calendar sync) ───────────────────────────────
MEETUP_CLIENT_ID=
MEETUP_CLIENT_SECRET=
MEETUP_REFRESH_TOKEN=
MEETUP_PRONETWORK_URLNAME=
MEETUP_GROUP_URLNAME=las-vegas-robotics-meetup
SYNC_PAST=false

# ── ReadyForRobots API (proxied same-origin, no key) ─────────────────
RFR_API_UPSTREAM=https://ready-2-robot.fly.dev/api/
RFR_API_BASE_PATH=/rfr-api

# ── Decommissioned Supabase project (reference only) ─────────────────
OLD_SUPABASE_PROJECT_REF=
OLD_SUPABASE_URL=

# ── Hosting ──────────────────────────────────────────────────────────
FLY_APP=lv-robotics
SITE_URL=
